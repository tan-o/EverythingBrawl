      }
     },
     "then": {
      "required": [
       "frame"
      ]
     },
     "else": {
      "properties": {
       "frame": false
      }
     }
    },
    {
     "if": {
      "properties": {
       "when": {
        "const": "every"
       }
      }
     },
     "then": {
      "required": [
       "interval"
      ]
     },
     "else": {
      "properties": {
       "interval": false
      }
     }
    },
    {
