 "$defs": {
  "cond": {
   "type": "object",
   "minProperties": 1,
   "additionalProperties": {
    "type": "string",
    "pattern": "^(>=|<=|==|>|<)\\s*-?[0-9]+(\\.[0-9]+)?$"
   }
  },
  "amounts": {
   "type": "object",
   "minProperties": 1,
   "additionalProperties": {
    "type": "number"
   }
  },
  "status": {
   "type": "object",
   "required": [
    "type",
    "duration"
   ],
   "additionalProperties": false,
   "properties": {
    "type": {
     "enum": [
      "burn",
      "slow",
      "stun",
      "root",
      "silence"
     ]
    },
    "damage": {
     "type": "number"
    },
    "interval": {
     "type": "integer",
     "minimum": 1
    },
    "duration": {
     "type": "integer",
     "minimum": 1
    },
    "factor": {
     "type": "number"
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "type": {
        "const": "burn"
       }
      }
     },
     "then": {
      "required": [
       "damage",
       "interval",
       "duration"
      ],
      "properties": {
       "factor": false
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "slow"
       }
      }
     },
     "then": {
      "required": [
       "factor",
       "duration"
      ],
      "properties": {
       "damage": false,
       "interval": false
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "stun"
       }
      }
     },
     "then": {
      "required": [
       "duration"
      ],
      "properties": {
       "damage": false,
       "interval": false,
       "factor": false
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "root"
       }
      }
     },
     "then": {
      "required": [
       "duration"
      ],
      "properties": {
       "damage": false,
       "interval": false,
       "factor": false
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "silence"
       }
      }
     },
     "then": {
      "required": [
       "duration"
      ],
      "properties": {
       "damage": false,
       "interval": false,
       "factor": false
      }
     }
    }
   ]
  },
  "link": {
   "type": "object",
   "required": [
    "when"
   ],
   "additionalProperties": false,
   "properties": {
    "when": {
     "enum": [
      "on_start",
      "on_end",
      "on_frame",
      "every",
      "on_hit",
      "on_whiff",
      "on_land",
      "on_release",
      "on_hurt",
      "projectile_hit",
      "projectile_expire",
      "resource_empty",
      "resource_full"
