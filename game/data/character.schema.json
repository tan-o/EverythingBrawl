    "if": {
     "$ref": "#/$defs/cond"
    },
    "require": {
     "enum": [
      "ground",
      "air",
      "any"
     ]
    },
    "goto": {
     "type": "string",
     "minLength": 1
    },
    "spawn": {
     "type": "string",
     "minLength": 1
    },
    "gain": {
     "$ref": "#/$defs/amounts"
