{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "character.schema.json",
 "title": "像素大乱斗角色包 character.json (format 1)",
 "type": "object",
 "required": [
  "format",
  "name",
  "frame_size",
  "anchor",
  "stats",
  "assets",
  "anims",
  "actions",
  "input"
 ],
 "additionalProperties": false,
 "properties": {
  "format": {
   "const": 1
  },
  "name": {
   "type": "string",
   "minLength": 1,
   "maxLength": 24
  },
  "frame_size": {
   "type": "array",
   "prefixItems": [
    {
     "type": "integer",
     "minimum": 1
    },
    {
     "type": "integer",
     "minimum": 1
    }
   ],
   "items": false,
   "minItems": 2
  },
  "anchor": {
   "type": "array",
   "prefixItems": [
    {
     "type": "integer"
    },
    {
     "type": "integer"
    }
   ],
   "items": false,
   "minItems": 2
  },
  "stats": {
   "type": "object",
   "required": [
    "hp",
    "body",
    "weight",
    "gravity",
    "max_fall",
    "air_control"
   ],
   "additionalProperties": false,
   "properties": {
    "hp": {
     "type": "number"
    },
    "body": {
     "type": "array",
     "prefixItems": [
      {
       "type": "integer",
       "minimum": 1
      },
      {
       "type": "integer",
       "minimum": 1
      }
     ],
     "items": false,
     "minItems": 2
    },
    "weight": {
     "type": "number"
    },
    "gravity": {
     "type": "number"
    },
    "max_fall": {
     "type": "number"
    },
    "air_control": {
     "type": "number"
    }
   }
  },
  "held": {
   "type": "string",
   "minLength": 1
  },
  "resources": {
   "type": "object",
   "additionalProperties": {
    "$ref": "#/$defs/resource"
   }
  },
  "assets": {
   "type": "object",
   "additionalProperties": {
    "$ref": "#/$defs/asset"
   }
  },
  "anims": {
   "type": "object",
   "additionalProperties": {
    "$ref": "#/$defs/anim"
   }
  },
  "forms": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/form"
   }
  },
  "actions": {
   "type": "object",
   "minProperties": 1,
   "additionalProperties": {
